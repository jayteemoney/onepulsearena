# OnePulse Arena - Environment Configuration

# ======================================
# NETWORK CONFIGURATION
# ======================================

# Sui Network (testnet, mainnet, devnet, localnet)
VITE_SUI_NETWORK=testnet

# OneChain Testnet RPC Endpoint
# Get from OneChain team: https://t.me/hello_onechain
# Or use default Sui testnet:
VITE_ONECHAIN_RPC_URL=https://fullnode.testnet.sui.io

# Note: App uses polling (3s interval) for event synchronization
# No WebSocket configuration needed - more reliable for public RPC endpoints!

# ======================================
# DEPLOYED CONTRACT
# ======================================

# Package ID (auto-filled by deploy script)
# Leave empty until you run: npm run deploy:move
VITE_PACKAGE_ID=

# Shared Object IDs (auto-filled by deploy script)
VITE_GAME_STATE_ID=
VITE_GLOBAL_LEADERBOARD_ID=
VITE_DAILY_LEADERBOARD_ID=

# ======================================
# GAME CONFIGURATION
# ======================================

# Points awarded per pulse action
VITE_PULSE_VALUE=100

# Cooldown between pulses in milliseconds (1 second)
VITE_PULSE_COOLDOWN_MS=1000

# Yield generation rate (0.01% per pulse)
VITE_YIELD_RATE=0.0001

# ======================================
# OPTIONAL: GAS ABSTRACTION
# ======================================

# Gas sponsor address (for sponsored transactions)
# Leave empty for user-paid gas
VITE_GAS_SPONSOR_ADDRESS=

# ======================================
# DEVELOPMENT
# ======================================

# Enable debug logging (true/false)
VITE_DEBUG=false

# ======================================
# NOTES
# ======================================

# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Update VITE_ONECHAIN_RPC_URL with OneChain testnet URL
#    (or use default Sui testnet for testing)
#
# 3. Deploy contracts to get PACKAGE_ID:
#    npm run deploy:move
#
# 4. PACKAGE_ID will be auto-filled by deployment script
#
# 5. Never commit .env to version control (it's in .gitignore)
